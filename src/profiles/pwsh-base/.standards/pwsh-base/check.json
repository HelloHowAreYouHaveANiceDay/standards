{
  "profile": "pwsh-base",
  "version": "0.0.0",
  "tools": {
    "PSScriptAnalyzer": "1.25.0"
  },
  "commands": [
    {
      "id": "psscriptanalyzer",
      "tool": "PSScriptAnalyzer 1.25.0",
      "run": [
        "pwsh",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".standards/pwsh-base/lint.ps1"
      ]
    }
  ]
}
