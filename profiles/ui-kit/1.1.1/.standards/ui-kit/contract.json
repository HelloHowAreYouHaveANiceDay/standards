    { "fg": "text", "bg": "panel", "min": 4.5 },
    { "fg": "text-muted", "bg": "background", "min": 4.5 },
    { "fg": "text-muted", "bg": "panel", "min": 4.5 },
    { "fg": "border", "bg": "background", "min": 3 },
    { "fg": "on-primary", "bg": "primary", "min": 4.5 },
    { "fg": "primary", "bg": "background", "min": 3 },
    { "fg": "on-alert", "bg": "alert", "min": 4.5 },
    { "fg": "alert", "bg": "background", "min": 4.5 },
    { "fg": "spot", "bg": "background", "min": 3 },
    { "fg": "focus", "bg": "background", "min": 3 }
  ],
  "extensionInk": { "suffixes": ["ink", "text"], "bg": "background", "min": 4.5 }
}
