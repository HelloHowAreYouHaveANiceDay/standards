{
  "profile": "ts-base",
  "version": "1.0.0",
  "tools": {
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "@eslint/js": "10.0.1",
    "eslint-config-prettier": "10.1.8",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "prettier": "3.10.0"
  },
  "commands": [
    {
      "id": "pins",
      "tool": "pins",
      "run": [
        "node",
        ".standards/ts-base/tool.mjs",
        "pins"
      ]
    },
    {
      "id": "typecheck",
      "tool": "tsc 6.0.3",
      "run": [
        "node",
        ".standards/ts-base/tool.mjs",
        "run",
        "typescript:tsc",
        "--build"
      ]
    },
    {
      "id": "eslint",
      "tool": "eslint 10.14.0",
      "run": [
        "node",
        ".standards/ts-base/tool.mjs",
        "run",
        "eslint",
        ".",
        "--max-warnings",
        "0"
      ]
    },
    {
      "id": "prettier",
      "tool": "prettier 3.10.0",
      "run": [
        "node",
        ".standards/ts-base/tool.mjs",
        "run",
        "prettier",
        "--check",
        ".",
        "!.standards/**",
        "!.standards.json",
        "!**/package-lock.json",
        "!**/worker-configuration.d.ts",
        "!eslint-suppressions.json"
      ]
    }
  ]
}
